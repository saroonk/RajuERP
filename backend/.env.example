# Copy to .env and edit. Never commit .env. Every value below is a placeholder: do not put real credentials in this file.
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# True for local development only. Must be False (the default) in production.
DJANGO_DEBUG=True
# Comma separated host names the API may be served from (add your deployment domain in production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origin(s) allowed to call the API with cookies (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. Leave DATABASE_URL empty to use SQLite (SQLITE_PATH) for local development.
# For Neon PostgreSQL set it to the pooled connection string, in this form (placeholders only):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
SQLITE_PATH=db.sqlite3
