# Copy to .env and edit. Never commit .env.
# Generate a key:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origin(s) allowed to call the API with cookies (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLite for development. For PostgreSQL later set DATABASE_URL-style values in settings.
SQLITE_PATH=db.sqlite3
